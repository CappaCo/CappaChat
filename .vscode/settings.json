{
    "deno.enable": true,
    "deno.lint": true,
    "deno.enablePaths": [
        "./routes",
        "./components",
        "./islands",
        "./main.ts",
        "./utils.ts",
        "./types.ts",
        "./deno.json",
        "./deno.lock"
    ],
    "editor.defaultFormatter": "denoland.vscode-deno",
    "[typescriptreact]": {
        "editor.defaultFormatter": "denoland.vscode-deno"
    },
    "[typescript]": {
        "editor.defaultFormatter": "denoland.vscode-deno"
    },
    "[javascriptreact]": {
        "editor.defaultFormatter": "denoland.vscode-deno"
    },
    "[javascript]": {
        "editor.defaultFormatter": "denoland.vscode-deno"
    }
}
